# Push Server Configuration

# VAPID Keys (generate with: npm run generate-keys)
VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:admin@srve.cc

# Server Port
PORT=3001

# Conference PIN Lookup (PIN-only join)
# Server-side JSON mapping file path; DO NOT ship this mapping to the web frontend.
CONFERENCE_PIN_MAP_PATH=./conferencePins.json

# Hashing pepper for PINs at rest (treat as secret; required when using pinsByHash)
CONFERENCE_PIN_PEPPER=

# Short-lived join token signing secret
CONFERENCE_JOIN_TOKEN_SECRET=
CONFERENCE_JOIN_TOKEN_TTL_SEC=90

# Guest SIP account used to register/call conferences when user enters only a PIN
CONFERENCE_GUEST_SIP_USER=
CONFERENCE_GUEST_SIP_PASS=

# Optional: Database connection (for persistent storage)
# DATABASE_URL=mongodb://localhost:27017/webrtc-push
