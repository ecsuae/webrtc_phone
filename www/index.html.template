<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>${DOMAIN} Webphone</title>

  <link rel="manifest" href="/manifest.json?v=20260307-r2">
  <meta name="theme-color" content="#2563eb">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/index.css?v=1773023054">
</head>
<body data-sip-domain="${PBX_IP}" data-wss-host="${DOMAIN}" data-skin="modern-ops" data-max-dial-digits="${DIAL_MAX_DIGITS}">
  <div id="appRoot"></div>

  <script src="/vendor/sip.min.js?v=20260306"></script>
  <script type="module">
    import { bootstrapPage } from "/app/page/bootstrapPage.js?v=1773032001";

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        bootstrapPage();
      });
    } else {
      bootstrapPage();
    }
  </script>
</body>
</html>

