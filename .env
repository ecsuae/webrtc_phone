
# ==========================================================
# 1. FRESH VPS VALUES — UPDATE THESE FIRST ON EACH NEW SERVER
# ==========================================================

# Public domain for this WebRTC phone deployment.
DOMAIN=mobi.srve.cc

# Public IPv4 address of this VPS.
PUBLIC_IP=188.34.145.231

# Public interface name used by RTPEngine on this VPS.
# Find it with:
#   ip -o route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}'
RTPENGINE_INTERFACE=ens192

# TURN hostname and relay IP. Usually same as DOMAIN and PUBLIC_IP.
TURN_HOST=mobi.srve.cc
TURN_RELAY_IP=188.34.145.231

# WireGuard peer IP assigned to this VPS.
WG_ADDRESS=10.252.253.4/32

# Admin backend bind address exposed only inside the WireGuard namespace.
# Use the same IP as WG_ADDRESS, without /32.
ADMIN_WG_BIND_HOST=10.252.253.4

# WireGuard server endpoint used by this VPS peer.
WG_ENDPOINT=wg.srve.cc:51820

# ==========================================================
# 2. PUBLIC WEB / NGINX / LET'S ENCRYPT
# ==========================================================

HTTP_PORT=80
HTTPS_PORT=443

LETSENCRYPT_EMAIL=ecsqatar@gmail.com
LETSENCRYPT_STAGING=0

# ==========================================================
# 3. PUSH SERVER
# ==========================================================

PUSH_LISTEN_HOST=0.0.0.0
PUSH_SERVER_PORT=3001

# Dialpad
DIAL_MAX_DIGITS=15

# ==========================================================
# 4. ADMIN BACKEND — WIREGUARD ONLY
# ==========================================================

# Admin listener inside push-server container.
# Must be 0.0.0.0 so admin-wg-forwarder can reach it over Docker network.
# It is not public unless port 8081 is published or nginx proxies /admin publicly.
ADMIN_BIND_HOST=0.0.0.0
ADMIN_BIND_PORT=8081

# Admin forwarder listener inside WireGuard namespace.
ADMIN_WG_BIND_PORT=8081

# WireGuard CIDR prefix allowed by push-server admin ACL.
WG_CIDR_PREFIX=10.252.253.

# ==========================================================
# 5. WIREGUARD PEER / CLIENT SECRETS
