# WebRTC SBC Configuration
# Copy this file to .env and update with your values

# Domain and Network Configuration
DOMAIN=phone.example.com
PUBLIC_IP=1.2.3.4
PBX_IP=pbx.example.com
PBX_PORT=5060

# TURN Server Credentials
TURN_USER=turnuser
TURN_PASS=changeme123

# RTP Port Range
RTP_MIN=30000
RTP_MAX=31000

# Push Notification Server (VAPID Keys)
# Generate new keys by running: cd push-server && node generate-keys.js
VAPID_PUBLIC_KEY=GENERATE_NEW_KEYS_USING_generate-keys.js
VAPID_PRIVATE_KEY=GENERATE_NEW_KEYS_USING_generate-keys.js
VAPID_SUBJECT=mailto:admin@example.com
