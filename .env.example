# WebRTC SBC Configuration
# Copy this file to .env and update with your values

# Domain and Network Configuration
DOMAIN=phone.example.com
PUBLIC_IP=1.2.3.4
PBX_IP=pbx.example.com
PBX_PORT=5060

RTPENGINE_INTERFACE=change-me
RTPENGINE_NG_PORT=2223

# Optional: multi-PBX (multi-tenant) routing based on SIP domain
# Map incoming request domain -> PBX host
PBX_MAP_1_DOMAIN=
PBX_MAP_1_HOST=
PBX_MAP_2_DOMAIN=
PBX_MAP_2_HOST=
PBX_MAP_3_DOMAIN=
PBX_MAP_3_HOST=
PBX_MAP_4_DOMAIN=
PBX_MAP_4_HOST=
PBX_MAP_5_DOMAIN=
PBX_MAP_5_HOST=
PBX_MAP_6_DOMAIN=
PBX_MAP_6_HOST=
PBX_MAP_7_DOMAIN=
PBX_MAP_7_HOST=
PBX_MAP_8_DOMAIN=
PBX_MAP_8_HOST=

# Optional: additional trusted SIP sources (PBX peers)
# Add IPs and domains here instead of editing kamailio.cfg.
# Leave empty if unused.
TRUSTED_SIP_IP_1=
TRUSTED_SIP_IP_2=
TRUSTED_SIP_IP_3=
TRUSTED_SIP_IP_4=
TRUSTED_SIP_IP_5=
TRUSTED_SIP_IP_6=
TRUSTED_SIP_IP_7=
TRUSTED_SIP_IP_8=

TRUSTED_SIP_DOMAIN_1=
TRUSTED_SIP_DOMAIN_2=
TRUSTED_SIP_DOMAIN_3=
TRUSTED_SIP_DOMAIN_4=
TRUSTED_SIP_DOMAIN_5=
TRUSTED_SIP_DOMAIN_6=
TRUSTED_SIP_DOMAIN_7=
TRUSTED_SIP_DOMAIN_8=

# TURN Server Credentials
TURN_HOST=phone.example.com
TURN_USER=turnuser
TURN_PASS=changeme123
TURN_RELAY_IP=${PUBLIC_IP}

TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

PUSH_SERVER_PORT=3001
KAMAILIO_WS_PORT=8443

LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=1

# TURN relay IP (often same as PUBLIC_IP on single-NIC servers)

# RTP Port Range
RTP_MIN=30000
RTP_MAX=31000

# Dialpad
# Max digits allowed in the dialed number input (affects desktop + Android UI)
DIAL_MAX_DIGITS=15

# Conference
# Feature flag: conference PIN join UI is hidden unless explicitly enabled
CONFERENCE_FEATURE_ENABLED=false

# Push Notification Server (VAPID Keys)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# Provisioning
PROVISIONING_PIN_PEPPER=change-me-to-a-long-random-secret

# Admin server — WireGuard-only listener for /dashboard and /diagnostics/errors
ADMIN_BIND_HOST=127.0.0.1
ADMIN_BIND_PORT=8081

ADMIN_WG_BIND_HOST=10.99.0.2
ADMIN_WG_BIND_PORT=8081

# WireGuard VPN peer (client)
WG_PRIVATE_KEY=change-me
WG_PRESHARED_KEY=change-me
WG_ADDRESS=10.99.0.2/32
WG_ENDPOINT=wg.example.com:51820
WG_PERSISTENT_KEEPALIVE=25
WG_ALLOWED_IPS=10.99.0.0/24
WG_PUBLIC_KEY=change-me
